# This is the configuration file for Ghostty.
#
# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
#
# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config.

# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc

gtk-titlebar = false
# theme = MemoryColor
theme = Cobalt2
# theme = OneHalfDark
# theme = Tomorrow Night
# theme = Garuda
# theme = Tomorrow Night Burns
# theme = Tomorrow Night Eighties
# theme = tokyonight
# theme = tokyonight-storm
# theme = tokyonight_moon
# theme = tokyonight_night

# theme = BlulocoDark
# theme = Everblush
# theme = ForestBlue

# font-family = JetBrainsMono Nerd Font
# font-family-bold = JetBrainsMono Nerd Font
# font-family-italic = JetBrainsMono Nerd Font
# font-family-bold-italic = JetBrainsMono Nerd Font
font-family = IosevkaTerm_IlovePlus
font-family-bold = IosevkaTerm_IlovePlus
font-family-italic = IosevkaTerm_IlovePlus
font-family-bold-italic = IosevkaTerm_IlovePlus

# font-family = mplus Nerd Font
# font-family-bold = mplus Nerd Font
# font-family-italic = mplus Nerd Font
# font-family-bold-italic = mplus Nerd Font

# font-family = FiraCode Nerd Font
# font-family-bold = FiraCode Nerd Font
# font-family-italic = Fira Mono
# font-family-bold-italic = Fira Mono

font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold-Italic

# font-style = Light
# font-style-bold = SemiBold
# font-style-italic = Italic
# font-style-bold-italic = SemiBold Italic

font-feature = -calt
font-feature = -liga
font-feature = -dlig   

# font-family = Fira Mono
# font-family-bold = Fira Mono
# font-family-italic = Fira Mono
# font-family-bold-italic = Fira Mono
#
# font-style = Regular
# font-style-bold = Bold
# font-style-italic = Italic
# font-style-bold-italic = Bold-Italic

font-size = 17.0

shell-integration-features = no-cursor
cursor-style = bar
# cursor-style = block
cursor-style-blink = true

cursor-color = #abb2bf
cursor-text = #282c34
selection-foreground = #2d353b
selection-background = #a8adba

# link-previews = false  # from v1.2.0
link-url = false
mouse-hide-while-typing = true

# window-padding-x = 2

keybind = ctrl+shift+down=scroll_page_lines:1
keybind = ctrl+shift+up=scroll_page_lines:-1
# keybind = global:super+alt+h=toggle_quick_terminal
# quick-terminal-position = bottom
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind

keybind = ctrl+enter=unbind
keybind = ctrl+shift+enter=unbind

keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9
keybind = ctrl+[=previous_tab
keybind = ctrl+]=next_tab
keybind = ctrl+shift+]=last_tab

quit-after-last-window-closed = true
